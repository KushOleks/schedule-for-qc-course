            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Room created\", () => {",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json).to.have.property(\"name\");",
                  "});",
                  "",
                  "pm.test(\"Name is correct\", () => {",
                  "    pm.expect(json.name).to.eql(pm.environment.get(\"newRoomName\"));",
                  "});",
                  "",
                  "pm.environment.set(\"roomId\", json.id);",
                  "pm.environment.set(\"originalRoomName\", json.name);",
                  "pm.environment.set(\"originalRoomTypeId\", json.type.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
